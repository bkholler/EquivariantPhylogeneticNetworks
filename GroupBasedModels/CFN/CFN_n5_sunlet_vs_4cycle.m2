load "../GroupBasedNetworks.m2"


-- set number of leaves and model
n = 5
M = CFNmodel


-- setup the ring and compute the vanishing ideal of the CFN model on the standard 4-sunlet
-- by results of https://arxiv.org/pdf/2312.07450, the ideal is generated by quadratics 
-- so it suffices to compute all quadratic generators of the kernel of the corresponding ring map
S = qRing(n, M);
images = sunletParam(n, M);
R = ring images_0;
phi = map(R, S, images);
H = componentsOfKernel(2, phi);
I = ideal delete(null, flatten values H)


-- now we compute the ideal of the 4-cycle + cherry
N1 = digraph(toList(1..10), {{6, 1}, {7, 2}, {8, 3}, {10, 4}, {10, 5}, {7, 6}, {9, 6}, {8, 7}, {8, 9}, {9, 10}})
imagesN1 = oneCycleNetworkParam({{7, 6}, {9, 6}}, N1, M);
phiN1 = map(ring imagesN1_0, S, imagesN1);
H1 = componentsOfKernel(2, phiN1);
I1 = ideal delete(null, flatten values H1);


 
N2 = digraph(toList(1..10), {{6, 3}, {7, 2}, {8, 1}, {10, 4}, {10, 5}, {6, 7}, {9, 6}, {8, 7}, {8, 9}, {9, 10}})
imagesN2 = oneCycleNetworkParam({{8, 7}, {6, 7}}, N2, M);
phiN2 = map(ring imagesN2_0, S, imagesN2);
H2 = componentsOfKernel(2, phiN2);
I2 = ideal delete(null, flatten values H2);

-- we see that N1 and N2 give the same model and it is contained in the CFN model on N
I1 == I2
isSubset(I, I1)
